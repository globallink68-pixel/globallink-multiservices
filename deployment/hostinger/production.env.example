APP_NAME="Global Link Multiservice"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://globallinkmultiservice.in
# Required: generate a private key on the server before enabling traffic.
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_HOSTINGER_DB_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_HOSTINGER_DATABASE
DB_USERNAME=REPLACE_WITH_HOSTINGER_DATABASE_USER
# Required: enter privately; never publish this completed file.
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
# Empty unless the actual upstream proxy IPs/CIDRs are independently verified.
# Allowed host is derived from APP_URL; there is no separate TRUSTED_HOSTS option.
TRUSTED_PROXIES=
# Fail closed on restricted or unverified metadata; use provider deactivation.
PROVIDER_PERMANENT_DELETE_ENABLED=false
# Enable only behind a verified proxy that replaces public request-ID headers.
TRUST_REQUEST_ID_HEADER=false
# SMTP is optional for current enquiry capture. Keep disabled until configured.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@globallinkmultiservice.in
MAIL_FROM_NAME="Global Link Multiservice"
MAIL_EHLO_DOMAIN=globallinkmultiservice.in
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=12
